# Copy this to .env and fill in your own values. .env is gitignored — never commit it.

AUTH_USER=admin
AUTH_PASS=changeme

# Port FileGuard listens on (host side)
PORT=5060

# Host folders to expose, one per browsable top-level folder. Each becomes
# /data/<name> inside the container. Add/remove lines and matching volume
# entries in docker-compose.yml to change what's browsable.
DOCUMENTS_DIR=/path/to/Documents
DOWNLOADS_DIR=/path/to/Downloads
ASSETS_DIR=/path/to/assets
PICTURES_DIR=/path/to/Pictures
MUSIC_DIR=/path/to/Music
CALIBRE_DIR=/path/to/calibre
VIDEOS_DIR=/path/to/Videos

# Read-only folder containing clamav/ (virus DB) and vt_api_key (VirusTotal key)
CONFIG_DIR=/path/to/config
